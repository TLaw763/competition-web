{
  "name": "enigmic-competition-tools",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
