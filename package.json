    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.23",
      "@enigmic-co/ui": "file:vendor/enigmic-co-ui-0.4.2.tgz"
    }
  }
}
